# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eventos?schema=public"
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Private file storage directory (never served statically)
STORAGE_DIR="./storage"
# Bearer token required by /api/cron/automations (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=""
# Show the demo accounts box on the login page in production (never for real data)
SHOW_DEMO_ACCOUNTS="false"
